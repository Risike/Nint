# Nint - Environment Configuration

# Server & API
PORT=3001
NODE_ENV=development
API_URL=http://localhost:3001/api
APP_BASE_URL=http://localhost:5173
# Required in production. Use a long random value.
JWT_SECRET=dev-only-change-this-secret
JWT_EXPIRES_IN=7d
# Comma-separated list of allowed browser origins (the frontend URL).
CORS_ORIGIN=http://localhost:5173
# Number of reverse-proxy hops in front of the API (1 behind nginx), or false.
TRUST_PROXY=false

# Optional administrator for development/test runs. Production has its own
# one-time bootstrap administrator and ignores these values.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# SQLite Database
DATABASE_PATH=./data/nint.db

# Transactional emails (password reset + account verification).
# In development, verification codes are printed to the backend console if SMTP is empty.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Nint Game <noreply@nint.app>

# Cloudflare Turnstile (free captcha).
# Development uses the official always-pass test keys when these are empty.
# Production MUST use real keys from https://dash.cloudflare.com/?to=/:account/turnstile
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Frontend
VITE_API_URL=http://localhost:3001/api

# Firebase Configuration (for Online 1v1 Realtime Gameplay)
# For local development, these can point to the Firebase Emulator or a demo project
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=nint-demo.firebaseapp.com
VITE_FIREBASE_DATABASE_URL=https://nint-demo-default-rtdb.firebaseio.com
VITE_FIREBASE_PROJECT_ID=nint-demo
VITE_FIREBASE_STORAGE_BUCKET=nint-demo.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=1234567890
VITE_FIREBASE_APP_ID=1:1234567890:web:abcdef123456

# The frontend automatically uses the local emulator in development when the Firebase config is the demo one.
# Set to true to force the emulator with a real project config. Never enable it in production.
VITE_USE_FIREBASE_EMULATOR=false
VITE_FIREBASE_EMULATOR_HOST=127.0.0.1
VITE_FIREBASE_EMULATOR_PORT=9000
VITE_FIREBASE_AUTH_EMULATOR_PORT=9099
