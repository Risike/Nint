# Nint - Environment Configuration

# Server & API
PORT=3001
NODE_ENV=development
API_URL=http://localhost:3001/api
JWT_SECRET=super-secret-nint-jwt-token-change-in-production
JWT_REFRESH_SECRET=super-secret-nint-refresh-token-change-in-production
JWT_EXPIRES_IN=7d

# SQLite Database
DATABASE_PATH=./data/nint.db

# Frontend
VITE_API_URL=http://localhost:3001/api

# Firebase Configuration (for Online 1v1 Realtime Gameplay)
# For local development, these can point to the Firebase Emulator or a demo project
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=nint-demo.firebaseapp.com
VITE_FIREBASE_DATABASE_URL=https://nint-demo-default-rtdb.firebaseio.com
VITE_FIREBASE_PROJECT_ID=nint-demo
VITE_FIREBASE_STORAGE_BUCKET=nint-demo.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=1234567890
VITE_FIREBASE_APP_ID=1:1234567890:web:abcdef123456

# Firebase Emulator toggle (set to true to connect to local RTDB emulator at localhost:9000)
VITE_USE_FIREBASE_EMULATOR=false
VITE_FIREBASE_EMULATOR_HOST=localhost
VITE_FIREBASE_EMULATOR_PORT=9000
