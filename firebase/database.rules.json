{
  "rules": {
    ".read": false,
    ".write": false,

    "matches": {
      "$matchId": {
        ".read": "auth != null",
        ".write": "auth != null && !data.exists()",

        "status": {
          ".write": "auth != null",
          ".validate": "newData.isString() && (newData.val() === 'waiting' || newData.val() === 'active' || newData.val() === 'finished')"
        },
        "startedAt": {
          ".write": "auth != null",
          ".validate": "newData.isNumber()"
        },
        "ranked": {
          ".validate": "newData.isBoolean()"
        },
        "nextMatch": {
          ".write": "auth != null"
        },
        "seed": {
          ".write": false
        },
        "players": {
          "$uid": {
            ".write": "auth != null && auth.uid == $uid",
            "displayName": {
              ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 32"
            },
            "userId": {
              ".validate": "newData.isString() && newData.val().length <= 100"
            },
            "rating": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 10000"
            },
            "score": {
              ".validate": "newData.isNumber() && newData.val() >= 0"
            },
            "lines": {
              ".validate": "newData.isNumber() && newData.val() >= 0"
            },
            "board": {
              ".validate": "newData.isString() && newData.val().length <= 40000"
            },
            "activePiece": {
              ".validate": "newData.val() === null || (newData.hasChildren(['type', 'x', 'y', 'rotation']) && newData.child('x').isNumber() && newData.child('y').isNumber())"
            },
            "alive": {
              ".validate": "newData.isBoolean()"
            },
            "connected": {
              ".validate": "newData.isBoolean()"
            },
            "ready": {
              ".validate": "newData.isBoolean()"
            },
            "lastSeen": {
              ".validate": "newData.isNumber()"
            },
            "$other": {
              ".validate": true
            }
          }
        },
        "attacks": {
          "$attackId": {
            ".write": "auth != null && newData.child('from').val() == auth.uid && newData.child('amount').isNumber() && newData.child('amount').val() >= 0 && newData.child('amount').val() <= 20",
            "from": {
              ".validate": "newData.isString() && newData.val() == auth.uid"
            },
            "amount": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 20"
            },
            "timestamp": {
              ".validate": "newData.isNumber()"
            }
          }
        },
        "rematch": {
          "$uid": {
            ".write": "auth != null && auth.uid == $uid",
            ".validate": "newData.isBoolean()"
          }
        },
        "events": {
          "$eventId": {
            ".write": "auth != null && newData.child('from').val() == auth.uid"
          }
        }
      }
    },

    "rooms": {
      "$roomCode": {
        ".read": "auth != null",
        ".write": "auth != null && (!data.exists() || data.child('hostUid').val() === auth.uid)",
        "hostUid": {
          ".validate": "newData.isString() && newData.val() == auth.uid"
        },
        "matchId": {
          ".validate": "newData.isString() && newData.val().length <= 100"
        },
        "status": {
          ".validate": "newData.isString()"
        },
        "ranked": {
          ".validate": "newData.isBoolean()"
        },
        "createdAt": {
          ".validate": "newData.isNumber()"
        }
      }
    },

    "matchmaking_queue": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && auth.uid == $uid",
        "uid": {
          ".validate": "newData.isString() && newData.val() == auth.uid"
        },
        "displayName": {
          ".validate": "newData.isString() && newData.val().length <= 32"
        },
        "userId": {
          ".validate": "newData.isString() && newData.val().length <= 100"
        },
        "rating": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 10000"
        },
        "roomCode": {
          ".validate": "newData.isString() && newData.val().length <= 12"
        },
        "matchId": {
          ".validate": "newData.isString() && newData.val().length <= 100"
        },
        "seed": {
          ".validate": "newData.isNumber()"
        },
        "ranked": {
          ".validate": "newData.isBoolean()"
        },
        "createdAt": {
          ".validate": "newData.isNumber()"
        }
      }
    }
  }
}
