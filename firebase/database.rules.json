{
  "rules": {
    ".read": false,
    ".write": false,

    "matches": {
      "$matchId": {
        ".read": "auth != null && (data.child('players').child(auth.uid).exists() || data.child('status').val() === 'waiting' || data.child('createdAt').val() < now - 7200000)",
        ".write": "auth != null && ((!data.exists() && newData.child('players').child(auth.uid).exists()) || (!newData.exists() && ((data.child('players').child(auth.uid).exists() && data.child('status').val() === 'waiting') || (data.child('createdAt').val() < now - 7200000 && data.child('status').val() != 'active') || data.child('createdAt').val() < now - 86400000)))

        "status": {
          ".write": "auth != null && (!data.exists() || root.child('matches').child($matchId).child('players').child(auth.uid).exists())",
          ".validate": "newData.isString() && (newData.val() === 'waiting' || newData.val() === 'active' || newData.val() === 'finished')"
        },
        "startedAt": {
          ".write": "auth != null && (!data.exists() || root.child('matches').child($matchId).child('players').child(auth.uid).exists())",
          ".validate": "newData.isNumber()"
        },
        "createdAt": {
          ".validate": "newData.isNumber()"
        },
        "ranked": {
          ".validate": "newData.isBoolean()"
        },
        "nextMatch": {
          ".write": "auth != null && root.child('matches').child($matchId).child('players').child(auth.uid).exists()",
          ".validate": "newData.hasChildren(['nextMatchId'])"
        },
        "seed": {
          ".write": false
        },
        "players": {
          "$uid": {
            ".write": "auth != null && auth.uid == $uid",
            "displayName": {
              ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 32"
            },
            "userId": {
              ".validate": "newData.isString() && newData.val().length <= 100"
            },
            "rating": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 10000"
            },
            "score": {
              ".validate": "newData.isNumber() && newData.val() >= 0"
            },
            "lines": {
              ".validate": "newData.isNumber() && newData.val() >= 0"
            },
            "board": {
              ".validate": "newData.isString() && newData.val().length <= 40000"
            },
            "activePiece": {
              ".validate": "newData.val() === null || (newData.hasChildren(['type', 'x', 'y', 'rotation']) && newData.child('x').isNumber() && newData.child('y').isNumber())"
            },
            "alive": {
              ".validate": "newData.isBoolean()"
            },
            "connected": {
              ".validate": "newData.isBoolean()"
            },
            "ready": {
              ".validate": "newData.isBoolean()"
            },
            "lastSeen": {
              ".validate": "newData.isNumber()"
            },
            "$other": {
              ".validate": true
            }
          }
        },
        "attacks": {
          ".write": "auth != null && !newData.exists() && root.child('matches').child($matchId).child('players').child(auth.uid).exists()",
          "$attackId": {
            ".write": "auth != null && root.child('matches').child($matchId).child('players').child(auth.uid).exists() && newData.child('from').val() == auth.uid && newData.child('amount').isNumber() && newData.child('amount').val() >= 0 && newData.child('amount').val() <= 20 && newData.child('timestamp').isNumber() && newData.child('timestamp').val() > now - 300000 && newData.child('timestamp').val() < now + 60000",
            "from": {
              ".validate": "newData.isString() && newData.val() == auth.uid"
            },
            "amount": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 20"
            },
            "timestamp": {
              ".validate": "newData.isNumber()"
            }
          }
        },
        "rematch": {
          "$uid": {
            ".write": "auth != null && auth.uid == $uid",
            ".validate": "newData.isBoolean()"
          }
        },
      }
    },

    "rooms": {
      "$roomCode": {
        ".read": "auth != null",
        ".write": "auth != null && (!data.exists() || data.child('hostUid').val() === auth.uid || (!newData.exists() && data.child('createdAt').val() < now - 86400000))",
        "hostUid": {
          ".validate": "newData.isString() && newData.val() == auth.uid"
        },
        "matchId": {
          ".validate": "newData.isString() && newData.val().length <= 100"
        },
        "status": {
          ".validate": "newData.isString()"
        },
        "ranked": {
          ".validate": "newData.isBoolean()"
        },
        "createdAt": {
          ".validate": "newData.isNumber()"
        }
      }
    },

    "matchmaking_queue": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && (auth.uid == $uid || (!newData.exists() && data.child('createdAt').val() < now - 600000))",
        "uid": {
          ".validate": "newData.isString() && newData.val() == auth.uid"
        },
        "displayName": {
          ".validate": "newData.isString() && newData.val().length <= 32"
        },
        "userId": {
          ".validate": "newData.isString() && newData.val().length <= 100"
        },
        "rating": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 10000"
        },
        "roomCode": {
          ".validate": "newData.isString() && newData.val().length <= 12"
        },
        "matchId": {
          ".validate": "newData.isString() && newData.val().length <= 100"
        },
        "seed": {
          ".validate": "newData.isNumber()"
        },
        "ranked": {
          ".validate": "newData.isBoolean()"
        },
        "createdAt": {
          ".validate": "newData.isNumber()"
        }
      }
    }
  }
}
